PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/data/>
PREFIX snvoc: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
SELECT ?personId ?firstName ?lastName ?friendshipCreationDate WHERE {
  sn:pers00000024189255811707 rdf:type snvoc:Person;
    snvoc:id ?rootId.
  {
    sn:pers00000024189255811707 snvoc:knows ?knows.
    ?knows snvoc:hasPerson ?person.
  }
  UNION
  {
    ?person snvoc:knows ?knows.
    ?knows snvoc:hasPerson sn:pers00000024189255811707.
  }
  ?knows snvoc:creationDate ?friendshipCreationDate.
  ?person snvoc:firstName ?firstName;
    snvoc:lastName ?lastName;
    snvoc:id ?personId.
}
ORDER BY DESC (?friendshipCreationDate) (?personId)
