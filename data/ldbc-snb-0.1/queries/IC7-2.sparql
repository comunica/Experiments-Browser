PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sn: <http://www.ldbc.eu/ldbc_socialnet/1.0/data/>
PREFIX snvoc: <http://www.ldbc.eu/ldbc_socialnet/1.0/vocabulary/>
SELECT ?personId (?firstName AS ?personFirstName) (?lastName AS ?personLastName) ?likeCreationDate (?minMessageId AS ?messageId) (?content AS ?messageContent) (?latency AS ?minutesLatency) ?isNew WHERE {
  {
    SELECT ?person (MIN(?messageId) AS ?minMessageId) WHERE {
      {
        SELECT ?personId (MAX(?likeDate) AS ?mostRecentLikeDate) WHERE {
          {
            SELECT DISTINCT ?message WHERE {
              VALUES ?type {
                snvoc:Comment
                snvoc:Post
              }
              sn:pers00000013194139533574 rdf:type snvoc:Person.
              ?message snvoc:hasCreator sn:pers00000013194139533574;
                rdf:type ?type.
            }
          }
          ?person rdf:type snvoc:Person;
            snvoc:likes ?like;
            snvoc:id ?personId.
          ?like (snvoc:hasPost|snvoc:hasComment) ?message;
            snvoc:creationDate ?likeDate.
        }
        GROUP BY ?personId
        ORDER BY DESC (?mostRecentLikeDate) (?personId)
        LIMIT 20
      }
      VALUES ?type {
        snvoc:Comment
        snvoc:Post
      }
      sn:pers00000013194139533574 rdf:type snvoc:Person.
      ?message snvoc:hasCreator sn:pers00000013194139533574;
        rdf:type ?type;
        snvoc:id ?messageId.
      ?person rdf:type snvoc:Person;
        snvoc:id ?personId;
        snvoc:likes ?like.
      ?like (snvoc:hasPost|snvoc:hasComment) ?message;
        snvoc:creationDate ?mostRecentLikeDate.
    }
    GROUP BY ?person
  }
  ?person snvoc:id ?personId;
    snvoc:firstName ?firstName;
    snvoc:lastName ?lastName;
    snvoc:likes ?like.
  ?like (snvoc:hasPost|snvoc:hasComment) ?message.
  ?message snvoc:id ?minMessageId.
  ?like snvoc:creationDate ?likeCreationDate.
  ?message snvoc:creationDate ?messageCreationDate;
    (snvoc:content|snvoc:imageFile) ?content.
  BIND(FLOOR((14  - (MONTH(?likeCreationDate))) / 12 ) AS ?likeA)
  BIND(((YEAR(?likeCreationDate)) + 4800 ) - ?likeA AS ?likeY)
  BIND(((MONTH(?likeCreationDate)) + (12  * ?likeA)) - 3  AS ?likeM)
  BIND((((((DAY(?likeCreationDate)) + (FLOOR(((153  * ?likeM) + 2 ) / 5 ))) + (365  * ?likeY)) + (FLOOR(?likeY / 4 ))) - (FLOOR(?likeY / 100 ))) + (FLOOR(?likeY / 400 )) AS ?likeDay)
  BIND(FLOOR((14  - (MONTH(?messageCreationDate))) / 12 ) AS ?messageA)
  BIND(((YEAR(?messageCreationDate)) + 4800 ) - ?messageA AS ?messageY)
  BIND(((MONTH(?messageCreationDate)) + (12  * ?messageA)) - 3  AS ?messageM)
  BIND((((((DAY(?messageCreationDate)) + (FLOOR(((153  * ?messageM) + 2 ) / 5 ))) + (365  * ?messageY)) + (FLOOR(?messageY / 4 ))) - (FLOOR(?messageY / 100 ))) + (FLOOR(?messageY / 400 )) AS ?messageDay)
  BIND(xsd:integer(((((?likeDay - ?messageDay) * 1440 ) + (((HOURS(?likeCreationDate)) - (HOURS(?messageCreationDate))) * 60 )) + (MINUTES(?likeCreationDate))) - (MINUTES(?messageCreationDate))) AS ?latency)
  sn:pers00000013194139533574 rdf:type snvoc:Person.
  BIND(NOT EXISTS { sn:pers00000013194139533574 ((snvoc:knows/snvoc:hasPerson)|^(snvoc:knows/snvoc:hasPerson)) ?person. } AS ?isNew)
}
ORDER BY DESC (?likeCreationDate) (?personId)
